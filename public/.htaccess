# IBTO site (React single-page app) on HostGator's Apache.
# Copied into dist/ by Vite. Guide: docs/deploy-homologacao.md.

Options -Indexes
DirectoryIndex index.html

# Unknown addresses get a real 404 status while still showing the app's own
# "not found" page (served from index.html).
ErrorDocument 404 /index.html

# PWA manifest (issue #9): Apache doesn't know the extension by default.
AddType application/manifest+json .webmanifest

<IfModule mod_rewrite.c>
  RewriteEngine On

  # HTTPS only.
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Legacy URL from the old site.
  RewriteRule ^services/?$ /areas-de-atuacao [R=301,L]

  # Site pages only exist in the browser: serve index.html with status 200.
  # Every page in src/routes must be listed here — tests/htaccess.test.ts
  # fails the build otherwise.
  RewriteRule ^(areas-de-atuacao|quem-somos|contato|rede-nacional|cursos|blog|eventos)/?$ /index.html [L]
  # Blog post and event album pages (#61, B4): /blog/<slug> and /eventos/<slug>.
  # The slug only takes lowercase letters, digits and hyphens (the format the
  # platform generates); anything else falls through to the 404 page.
  RewriteRule ^(blog|eventos)/[a-z0-9-]+/?$ /index.html [L]
</IfModule>

# Secrets for mensagem.php: readable by PHP on disk, never over HTTP.
<FilesMatch "^config(\.example)?\.php$">
  Require all denied
</FilesMatch>

# File list the automatic deploy (.github/workflows/deploy.yml) keeps on the
# server to upload only what changed. Not for the public.
<Files ".ftp-deploy-sync-state.json">
  Require all denied
</Files>

# Janelinha de usuário e senha da homologação (issue #24): TIRADA em 17/10/2026,
# a pedido do Gleyson, para o piloto (várias pessoas indicadas vão acessar). O
# site é a vitrine pública; o que tem dado fica na plataforma, com login. A
# homologação continua fora do Google pelo "noindex" mais abaixo. Para VOLTAR
# com a janelinha, reverta a PR que a tirou (o bloco <If> da senha básica do
# Apache e o arquivo .htpasswds/homolog.ib-to.org/passwd).

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  # %{HTTPS} works on HostGator; the HTTPS environment variable is not set
  # there, so a header conditioned on it never went out (homologação #15).
  <If "%{HTTPS} == 'on'">
    Header always set Strict-Transport-Security "max-age=31536000"
  </If>

  # connect-src inclui a plataforma de cursos (cursos.ib-to.org e a de testes):
  # o bloco "Últimas do IBTO" da página inicial busca os posts do blog lá (#61).
  # frame-src inclui o YouTube sem cookies (vídeo dos posts do blog, #61 B4) e
  # media-src a plataforma (vídeo enviado como arquivo).
  # Report-only for now: logs violations in the browser console without
  # blocking anything, so the VLibras widget's real needs can be checked
  # before this is enforced.
  Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' https://vlibras.gov.br https://*.vlibras.gov.br https://cdn.jsdelivr.net/gh/spbgovbr-vlibras/; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://vlibras.gov.br https://*.vlibras.gov.br https://cdn.jsdelivr.net/gh/spbgovbr-vlibras/; font-src 'self' data: https://fonts.gstatic.com https://vlibras.gov.br https://*.vlibras.gov.br https://cdn.jsdelivr.net/gh/spbgovbr-vlibras/; img-src 'self' data: blob: https:; connect-src 'self' https://cursos.ib-to.org https://cursos-homolog.ib-to.org https://vlibras.gov.br https://*.vlibras.gov.br https://cdn.jsdelivr.net/gh/spbgovbr-vlibras/; frame-src https://www.youtube-nocookie.com https://vlibras.gov.br https://*.vlibras.gov.br; media-src 'self' https://cursos.ib-to.org https://cursos-homolog.ib-to.org; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"

  # Staging must never be indexed by search engines.
  <If "%{HTTP_HOST} == 'homolog.ib-to.org'">
    Header always set X-Robots-Tag "noindex, nofollow"
  </If>

  # Build files have a content hash in their name, so they can be cached
  # forever; HTML must always be revalidated to pick up new deploys.
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # PWA (issue #9): the service worker and the manifest keep their names
  # between deploys, so they must be revalidated too, or visitors who
  # already opened the site would stay on the old version.
  <FilesMatch "^(sw\.js|registerSW\.js|workbox-[\w-]+\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json application/xml image/svg+xml
</IfModule>
