# Copy this file to .env and fill in real values for server/index.ts.

# Redis cache (optional — the API falls back to uncached responses if unset/unreachable)
REDIS_URL=redis://localhost:6379

# Contact form (QA_REPORT.html BUG-009) — sent via Resend's HTTP API (resend.com).
# Without RESEND_API_KEY the /api/contact endpoint responds with an error so the
# form fails visibly instead of silently pretending to send.
RESEND_API_KEY=
# The institute's official contact inbox (also the default in code).
CONTACT_TO_EMAIL=comando.ibto@gmail.com
CONTACT_FROM_EMAIL=ouvidoria@ib-to.org

# Contact form endpoint used by the browser. Leave unset for local dev
# (`bun run dev` + `bun run server` use /api/contact). Production builds
# already get /mensagem.php from .env.production — no need to set it here.
VITE_CONTACT_ENDPOINT=
