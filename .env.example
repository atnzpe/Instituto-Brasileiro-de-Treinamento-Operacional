# Copy this file to .env and fill in real values for server/index.ts.

# Redis cache (optional — the API falls back to uncached responses if unset/unreachable)
REDIS_URL=redis://localhost:6379

# Contact form (QA_REPORT.html BUG-009) — sent via Resend's HTTP API (resend.com).
# Without RESEND_API_KEY the /api/contact endpoint responds with an error so the
# form fails visibly instead of silently pretending to send.
RESEND_API_KEY=
# Defaults to eduars.lopes@gmail.com in code until a dedicated inbox exists.
CONTACT_TO_EMAIL=eduars.lopes@gmail.com
CONTACT_FROM_EMAIL=ouvidoria@ib-to.org

# Only needed for a STATIC deploy with no Bun API running (e.g. HostGator
# shared hosting) — points the contact form at public/contact.php instead of
# the dev-only /api/contact. Leave unset for local dev (`bun run dev` +
# `bun run server`). Build with: VITE_CONTACT_ENDPOINT=/contact.php bun run build
VITE_CONTACT_ENDPOINT=
